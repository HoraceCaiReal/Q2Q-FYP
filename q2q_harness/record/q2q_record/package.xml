<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>q2q_record</name>
  <version>0.1.0</version>
  <description>
    记录层：第 7 步第一片把 TaskState 逐条落成 JSONL（每行 flush、周期 fsync、写失败即退出）。
    接口定稿见 docs/decisions/2026-10-24-第7步接口定稿-第一片.md 的 I4。
  </description>
  <maintainer email="q2q@fyp.local">Cai Haoxian</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>q2q_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
